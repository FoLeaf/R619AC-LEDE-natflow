# 竞斗云 2.0 / P&W R619AC (IPQ4019) —— Lean LEDE + natflow 种子配置
# 这是一份「种子」.config，只写关键项，交给 `make defconfig` 补全其余依赖。

# ---- 目标平台 ----
# 选 essedma + ar40xx(swconfig) 驱动的 ipq40xx，而不是上游 23.05+ 的 DSA 驱动
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_p2w_r619ac-128m=y

# ---- 快速转发引擎 ----
# IPQ4019 没有 NSS 协处理器，真正的加速来自 essedma 的多队列/硬件卸载 + natflow 软件快速路径
CONFIG_PACKAGE_kmod-natflow=y
CONFIG_PACKAGE_natflow-boot=y

# ---- 无线 ----
# 驱动编进去但首次开机自动关闭射频，以后想临时开 AP 不用重刷
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca4019-ct=y

# ---- 性能诊断与测速 ----
# ethtool 是必需的，不是可选：natflow-boot 靠它关掉 eth 口的 GRO/GSO
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-cpufreq=y

# ---- USB 3.0 存储（按需，不用可以删掉这一段） ----
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
